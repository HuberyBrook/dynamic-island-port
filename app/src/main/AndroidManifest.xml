<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LSPosed module: no launcher needed -->
    <application
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Xposed module entry: triggers settings UI category -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="Port A16 Dynamic Island (Super Island) features to A15 System UI" />

        <meta-data
            android:name="xposedminversion"
            android:value="100" />

        <!-- Scope: only hook SystemUI process, not all apps -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
